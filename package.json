{
  "name": "landed",
  "private": true,
  "description": "Landed \u2014 local-first outcome ledger for AI coding agents",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "lint": "biome check . && node scripts/check-boundaries.mjs",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm --filter @landed/web build && pnpm --filter landed-agents build",
    "landed": "node apps/cli/dist/landed.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^22.20.4",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "license": "Apache-2.0"
}
